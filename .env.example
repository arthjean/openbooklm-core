# OpenbookLM core — self-hosted configuration
#
# The public export publishes this file as `.env.example` at the root of the
# public repository (see scripts/export-public-repo.sh). It lists every
# variable the reference server (`openbooklm-server`) reads, and no other: there
# is no Clerk, Stripe, Resend or PostHog value here and the server never looks
# for one.
#
# Copy to `.env` and fill the three REQUIRED values. Everything else has a
# working default; the commented value is that default.
#
# To try the stack with no provider account at all, set
# OPENBOOKLM_DETERMINISTIC_PROVIDERS=true and leave the provider keys empty.

# =============================================================================
# REQUIRED
# =============================================================================

# PostgreSQL with the pgvector extension. Any Postgres 14+ works; the reference
# Compose stack ships one.
DATABASE_URL=postgres://openbooklm:openbooklm@localhost:5432/openbooklm

# Embeddings (Voyage AI — https://www.voyageai.com/). Retrieval cannot index or
# search a source without it, so startup fails when it is missing.
VOYAGE_API_KEY=pa-...

# At least one LLM provider. Startup fails when all three are absent.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# MISTRAL_API_KEY=...

# --- or no provider at all ---------------------------------------------------
# Replaces embeddings, reranking and generation with in-process fixtures, so the
# stack starts and the whole ingest-and-cite path works with none of the keys
# above. It is how public CI proves that path end to end.
#
# Retrieval becomes token overlap and answers become quotes of the retrieved
# chunk. Good for a first look, a demo or an integration test. Never for real
# users: the answers are not generated, they are echoed back.
# OPENBOOKLM_DETERMINISTIC_PROVIDERS=false

# =============================================================================
# IDENTITY (reference server)
# =============================================================================
# Two modes, chosen by whether a token is set:
#
#   no token  + loopback bind -> every local request is the single operator
#   token set + any bind      -> `Authorization: Bearer <token>` is required
#
# Binding a non-loopback address without a token is refused at startup.

# OPENBOOKLM_BIND=127.0.0.1
# Generate with: openssl rand -hex 32   (32 characters minimum)
# OPENBOOKLM_AUTH_TOKEN=
# Pin the account UUID so a reattached volume keeps its notebooks.
# OPENBOOKLM_ACCOUNT_ID=00000000-0000-4000-8000-000000000001

# =============================================================================
# SERVER
# =============================================================================

# PORT=3001
# FRONTEND_URL=http://localhost:3000     # also the default CORS origin
# RUST_LOG=info,tower_http=debug
# LOG_FORMAT=                            # `json` for structured logs
# OPENBOOKLM_EVENT_LOG=false             # log domain events instead of dropping them
# HEALTH_TOKEN=                          # required as x-health-token on /health/detailed
# CORS_ALLOWED_ORIGINS=                  # comma-separated; defaults to FRONTEND_URL
# TRUSTED_PROXY_MODE=false               # trust X-Forwarded-For (only behind a proxy you control)
# RATE_LIMIT_RPM=60
# BODY_LIMIT_BYTES=1048576
# UPLOAD_LIMIT_BYTES=10485760
# REQUEST_TIMEOUT_SECS=120
# LLM_TIMEOUT_SECS=120
# SHUTDOWN_TIMEOUT_SECS=30

# Distributed rate limiting across replicas (optional; in-memory otherwise)
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=

# =============================================================================
# DATABASE POOL
# =============================================================================

# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT=10
# DB_ACQUIRE_TIMEOUT=30
# DB_IDLE_TIMEOUT=600
# DB_MAX_LIFETIME=1800

# =============================================================================
# INGESTION
# =============================================================================

# Web scraping (Firecrawl — https://www.firecrawl.dev/). Without it, web
# sources are unavailable; every other source type still works. Firecrawl also
# performs the server-side SSRF protection the core relies on, which is why the
# core never fetches a user-supplied URL itself.
# FIRECRAWL_API_KEY=fc-...

# YouTube transcripts
# YOUTUBE_PROXY_URL=
# YOUTUBE_INNERTUBE_API_KEY=             # overrides the embedded public key
# DEFAULT_LOCALE=en                      # transcript language preference

# OCR fallback for scanned PDFs (Mistral OCR; reuses MISTRAL_API_KEY)
# OCR_ENABLED=false
# OCR_MODEL=mistral-ocr-latest
# OCR_TIMEOUT_SECS=120
# OCR_MIN_TEXT_THRESHOLD=50              # min chars/page before OCR kicks in
# OCR_MAX_PAGES_PER_REQUEST=1000
# OCR_MAX_FILE_SIZE_BYTES=52428800       # 50 MB ceiling imposed by the provider

# =============================================================================
# RETRIEVAL
# =============================================================================

# VOYAGE_EMBEDDING_MODEL=voyage-4        # voyage-4, voyage-4-lite, voyage-4-large
# VOYAGE_MAX_RPM=300
# VOYAGE_MAX_TPM=2000000
# VOYAGE_BATCH_SIZE=128
# VOYAGE_CONCURRENT_BATCHES=4

# HYBRID_SEARCH_ENABLED=true
# HYBRID_SEARCH_RRF_K=60
# HYBRID_SEARCH_DENSE_WEIGHT=0.7
# HYBRID_SEARCH_SPARSE_WEIGHT=0.3

# RETRIEVAL_POOL_SIZE=50                 # candidates before reranking (20-500)
# HYDE_ENABLED=false                     # hypothetical-document expansion
# RERANK_MIN_CHUNKS=200                  # skip reranking below this chunk count
# CONTEXT_STUFFING_MAX_CHUNKS=150        # load all chunks directly for small notebooks (0 disables)

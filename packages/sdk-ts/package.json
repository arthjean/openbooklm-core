{
  "name": "@openbooklm/sdk",
  "version": "0.1.0",
  "description": "Typed client for the OpenbookLM core API. Generated from the Rust definitions.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../contracts/openapi.json --output src/generated/openapi.ts && node scripts/generate-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}

{
  "name": "@openbooklm/sdk",
  "version": "0.0.3",
  "description": "Typed client for the OpenbookLM core API. Generated from the Rust definitions.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/arthjean/openbooklm-core",
    "directory": "packages/sdk-ts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "openapi-typescript ../../contracts/openapi.json --output src/generated/openapi.ts && node scripts/generate-catalog.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "sideEffects": false
}
